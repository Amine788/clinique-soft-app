# NextClinic : front (fichiers statiques) et reverse proxy vers l'API, à la même adresse.
# SITE_ADDRESS = nom de domaine en production (HTTPS automatique, ex. erp.ma-clinique.ma) ; « :80 » par défaut (HTTP local).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Fichiers téléversés publics (photos, logos) : jamais exécutés comme une page, même si un fichier était piégé
	@uploads path /uploads/*
	header @uploads Content-Security-Policy "sandbox; default-src 'none'; img-src 'self'"

	# API, fichiers publics (photos, logos) et temps réel (WebSocket relayé automatiquement)
	@api path /api/* /uploads/* /socket.io/*
	handle @api {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3001
	}

	# Application React : toute route inconnue renvoie index.html
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# Pas de journal d'accès : les adresses de l'API contiennent des identifiants de patients (CIN).
	# Les erreurs de Caddy restent journalisées ; l'API journalise ses requêtes avec les CIN masqués.
}
