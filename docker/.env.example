# Copier en docker/.env (jamais commité) et remplacer TOUTES les valeurs.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Adresse publique ──
# Production : nom de domaine (HTTPS automatique par Caddy) ; FRONTEND_URL = https://ce-domaine
SITE_ADDRESS=:80
FRONTEND_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# ── Base de données (MySQL 8.4, conteneur « db ») ──
DB_NAME=nextclinic_db
DB_USER=nextclinic_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Compte créé par l'image MySQL sur base neuve : distinct de celui de l'API.
DB_BOOTSTRAP_USER=nextclinic_bootstrap
DB_BOOTSTRAP_PASSWORD=change-me
# Installation explicite seulement (profil install), compte administratif distinct.
# Ne pas recopier ces identifiants dans DB_USER/DB_PASSWORD de l'API. Avec le journal binaire actif
# (défaut), la création des triggers exige un compte administratif : root et DB_ROOT_PASSWORD conviennent.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
TZ=Africa/Casablanca

# ── Authentification ──
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# ── Super-admin initial (créé seulement s'il n'en existe aucun ; 12 caractères minimum) ──
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── E-mails (Gmail : mot de passe d'application ; autre fournisseur : SMTP_HOST / SMTP_PORT) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
# Autre fournisseur : les variables SMTP_* priment sur les identifiants Gmail.
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition simple, nécessaire si SMTP_USER n'est pas une adresse e-mail.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ── IA (Anthropic) : lecture automatique de la CIN ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=20000

# Étiquette des images construites (ex. date ou version) : permet de revenir à la précédente
APP_VERSION=local
