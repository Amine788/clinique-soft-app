# Copier ce fichier en server/.env et remplacer les valeurs factices.
# Ne jamais committer server/.env.

# ── Base de données MySQL (XAMPP en local) ──
DB_NAME=clinicsoft_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Mode Postgres (Neon) : si cette variable est définie, elle remplace la config MySQL ci-dessus.
# Format : postgres://<utilisateur>:<mot-de-passe>@<hote>/<base>?sslmode=require
# DATABASE_URL=

# ── Authentification ──
# Générer une valeur aléatoire longue, par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# ── Serveur ──
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Emails : adresse d'envoi unique de la plateforme (bienvenue, lien de mot de passe, invitations,
#    puis e-mails patients au nom de chaque clinique) ──
# Gmail : GMAIL_USER = l'adresse, GMAIL_APP_PASSWORD = mot de passe d'application (16 caractères)
GMAIL_USER=adresse@example.com
GMAIL_APP_PASSWORD=change-me
# Autre fournisseur (ex. clinique@votre-domaine) : serveur SMTP du fournisseur (Gmail par défaut)
# SMTP_HOST=smtp.votre-fournisseur.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ── Super-admin initial (créé au démarrage seulement si aucun n'existe ; 12 caractères minimum) ──
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── IA (Anthropic) ──
ANTHROPIC_API_KEY=change-me
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=20000
