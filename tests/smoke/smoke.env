# Valeurs de TEST uniquement (aucun secret réel) : base jetable, e-mails capturés par Mailpit.
# Utilisé par tests/smoke/run.sh (modes local et docker). Ne jamais réutiliser en production.
DB_NAME=nextclinic_smoke
DB_USER=smoke_app
# Compte créé par l'image MySQL (droits sur toute la base) : distinct du compte limité de l'API
DB_BOOTSTRAP_USER=smoke_bootstrap
DB_BOOTSTRAP_PASSWORD=smoke-bootstrap-password
DB_PASSWORD=smoke-app-password
DB_ROOT_PASSWORD=smoke-root-password
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=smoke-root-password
TZ=Africa/Casablanca
JWT_SECRET=smoke-test-jwt-secret-not-for-production-0123456789abcdef
JWT_EXPIRES_IN=8h
SUPER_ADMIN_EMAIL=superadmin@smoke.test
SUPER_ADMIN_PASSWORD=SmokeSuperAdmin2026!
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=smoke
SMTP_PASSWORD=smoke
EMAIL_FROM=noreply@smoke.test
ADMIN_NOTIFICATION_EMAIL=ops@smoke.test
# Vides exprès : une clé ou un compte réels d'un server/.env local ne doivent jamais servir aux tests
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# (aucun envoi Gmail : Mailpit via SMTP_* ci-dessus)
ANTHROPIC_API_KEY=""
# (aucun appel à l'IA pendant les tests)
SITE_ADDRESS=:80
HTTP_PORT=8091
HTTPS_PORT=8444
FRONTEND_URL=http://127.0.0.1:8091
APP_VERSION=smoke
