# NextClinic — variables de PRODUCTION (docker-compose.prod.yml et scripts/).
# Copier en .env.prod à la racine du dépôt, remplacer TOUTES les valeurs « change-me », puis : chmod 600 .env.prod
# .env.prod n'est jamais commité ni copié dans une image. Les scripts refusent de démarrer s'il reste « change-me ».
# Secrets aléatoires : openssl rand -hex 48 (une valeur différente pour chacun). Aucun guillemet autour des valeurs.

# ── Adresse publique ──
# Domaine ou sous-domaine servi par Caddy (certificat HTTPS automatique) ; son enregistrement DNS A doit viser le VPS
SITE_ADDRESS=erp.example.test
# URL publique complète du front : seule origine acceptée par l'API (CORS) et base des liens envoyés par e-mail
FRONTEND_URL=https://erp.example.test
# Ports publiés sur le VPS (HTTP redirige vers HTTPS) ; ne changer qu'en cas de conflit
HTTP_PORT=80
HTTPS_PORT=443

# ── Base de données MySQL (conteneur « db », jamais exposé sur Internet) ──
# Nom de la base
DB_NAME=nextclinic_db
# Compte LIMITÉ utilisé par l'API (créé et mis à jour par le service db-app-account) ; jamais root
DB_USER=nextclinic_app
# Mot de passe du compte de l'API : openssl rand -hex 48
DB_PASSWORD=change-me
# Mot de passe root MySQL (installation, comptes, sauvegardes, restauration) : openssl rand -hex 48
DB_ROOT_PASSWORD=change-me
# Compte créé par l'image MySQL sur une base neuve, distinct de DB_USER
DB_BOOTSTRAP_USER=nextclinic_bootstrap
# Son mot de passe : openssl rand -hex 48
DB_BOOTSTRAP_PASSWORD=change-me
# Compte administratif des installations de schéma (journal binaire actif : triggers créés par root)
DB_MIGRATION_USER=root
# Même valeur que DB_ROOT_PASSWORD
DB_MIGRATION_PASSWORD=change-me
# Fuseau horaire de la clinique (base, API, rappels de rendez-vous)
TZ=Africa/Casablanca

# ── Sessions ──
# Clé de signature des sessions (JWT), longue et aléatoire : openssl rand -hex 48 ; la changer déconnecte tout le monde
JWT_SECRET=change-me
# Durée d'une session
JWT_EXPIRES_IN=8h

# ── Super-administrateur initial (créé au premier démarrage s'il n'en existe aucun) ──
# Adresse de connexion du super-administrateur de la plateforme
SUPER_ADMIN_EMAIL=admin@example.test
# Mot de passe (12 caractères minimum) : openssl rand -hex 16 ; à retirer de ce fichier après la première connexion
SUPER_ADMIN_PASSWORD=change-me

# ── E-mails (bienvenue, liens de mot de passe, rappels, notifications) ──
# Gmail : adresse d'envoi et mot de passe d'application (16 caractères, compte avec validation en deux étapes)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Autre fournisseur : serveur SMTP (prioritaire sur Gmail s'il est renseigné)
SMTP_HOST=
# Port SMTP avec STARTTLS (vérifier que l'hébergeur ne le bloque pas)
SMTP_PORT=587
# Identifiant SMTP
SMTP_USER=
# Mot de passe SMTP
SMTP_PASSWORD=
# Adresse d'expédition, nécessaire si SMTP_USER n'est pas une adresse e-mail
EMAIL_FROM=
# Destinataire des notifications internes (nouvelle clinique inscrite)
ADMIN_NOTIFICATION_EMAIL=

# ── IA : lecture automatique de la CIN et assistant (facultatif : sans clé, ces fonctions répondent 503) ──
# Clé d'API dédiée à la production, avec plafond de dépense
ANTHROPIC_API_KEY=
# Modèle utilisé (vide = valeur par défaut du code)
AI_MODEL=
# Longueur maximale d'une réponse
AI_MAX_TOKENS=1024
# Délai maximal d'un appel, en millisecondes
AI_TIMEOUT_MS=20000

# ── Sauvegardes (scripts/backup.sh) ──
# Dossier des sauvegardes sur le VPS (hors du dépôt ; créé en 700, fichiers en 600)
BACKUP_DIR=/var/backups/nextclinic
# Nombre de jours de sauvegardes gardées sur le VPS
RETENTION_JOURS=14
# Copie hors du VPS après chaque sauvegarde (rsync par SSH avec clé) ; vide = pas de copie distante
BACKUP_RSYNC_DEST=
